    "Rétention : chance de te souvenir d'une carte le jour où elle revient. Plus haut = plus de révisions. 90 % est un bon choix.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retention: chance of remembering a card on the day it comes back. Higher = more reviews. 90% is a good choice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétention : chance de te souvenir d'une carte le jour où elle revient. Plus haut = plus de révisions. 90 % est un bon choix."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆率：卡片再次出现当天记住的概率。越高复习越多。90% 是不错的选择。"
          }
        }
      }
    },
