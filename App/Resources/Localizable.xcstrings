    "Les cartes arrivent comme neuves dans Anki : l'historique de révision ne suit pas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards arrive as new in Anki: review history does not follow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes arrivent comme neuves dans Anki : l'historique de révision ne suit pas."
