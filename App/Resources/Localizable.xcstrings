          "stringUnit": {
            "state": "translated",
            "value": "« Révisions » propose chaque jour les mots gardés, au bon moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“复习”每天在合适的时间提供已保存的单词。"
          }
        }
      }
    },
    "« Voir le journal » s'ouvre vite, même long.": {
