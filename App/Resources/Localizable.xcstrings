        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creativity. 0: always the most likely answer (reliable, repetitive); 0.7 and above: more varied but more errors. Automatic: 0 in a book, 0.3 in free chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créativité. 0 : toujours la réponse la plus probable (fiable, répétitive) ; 0,7 et plus : plus varié mais plus d'erreurs. Automatique : 0 sur un livre, 0,3 en discussion libre."
          }
        }
      }
