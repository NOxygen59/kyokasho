    "De petites pastilles indiquent ce que fait chaque IA. Elles deviennent plus discrètes quand un modèle reste simplement chargé en mémoire.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small badges show what each AI is doing. They become more discreet when a model is just kept loaded in memory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De petites pastilles indiquent ce que fait chaque IA. Elles deviennent plus discrètes quand un modèle reste simplement chargé en mémoire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小徽标显示每个 AI 正在做什么。模型只是留在内存中时，徽标会更不显眼。"
          }
        }
      }
