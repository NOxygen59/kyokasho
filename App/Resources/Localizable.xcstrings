    "Analyseur japonais : lectures des furigana selon le contexte (今日, 上手, 一日…) et découpage en mots. Remplace l'analyseur d'iOS dès qu'il est installé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Japanese analyzer: context-aware furigana readings (今日, 上手, 一日…) and word splitting. Replaces the iOS analyzer once installed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyseur japonais : lectures des furigana selon le contexte (今日, 上手, 一日…) et découpage en mots. Remplace l'analyseur d'iOS dès qu'il est installé."
          }
        }
      }
    },
