    "Évite qu'il boucle sur la même phrase. 1,1 suffit en général ; trop fort, il évite aussi les mots utiles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops it from looping on the same sentence. 1.1 is usually enough; too high, it also avoids useful words."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite qu'il boucle sur la même phrase. 1,1 suffit en général ; trop fort, il évite aussi les mots utiles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止反复循环同一句话。通常 1.1 就够了；太高也会避开有用的词。"
          }
        }
      }
    },
