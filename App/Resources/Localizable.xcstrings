          "stringUnit": {
            "state": "translated",
            "value": "新导入的 CBZ 从左到右阅读。"
          }
        }
      }
    },
    "OCR et furigana : un seul résultat retenu par page, le moteur choisi tient, et une correction à la main passe toujours d'abord.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR and furigana: one result kept per page, the chosen engine sticks, and a manual correction always comes first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR et furigana : un seul résultat retenu par page, le moteur choisi tient, et une correction à la main passe toujours d'abord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR 与注音：每页只保留一个结果，所选引擎保持不变，手动更正始终优先。"
          }
        }
      }
    },
