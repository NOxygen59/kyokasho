    "Page unique avec glissement : le double toucher zoome avec une animation, un second ramène la page entière.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single page with scrolling: a double tap zooms in with an animation, a second one brings back the whole page."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page unique avec glissement : le double toucher zoome avec une animation, un second ramène la page entière."
