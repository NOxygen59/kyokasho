    "« %@ » (%@) est déjà importé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” (%@) is already imported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » (%@) est déjà importé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”（%@）已导入。"
          }
        }
      }
    },
    "« %@ » : la catégorie s'affiche sur l'accueil pour t'aider à te repérer. Tu pourras la changer dans « Ce document ».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”: the category shows on the home screen to help you find your way. You can change it in “This document”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » : la catégorie s'affiche sur l'accueil pour t'aider à te repérer. Tu pourras la changer dans « Ce document »."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”：分类显示在主页上，方便你查找。可在“此文档”中更改。"
          }
        }
      }
    },
    "« %@ » du %@ : %lld documents, %lld notes, %lld cartes. Ta bibliothèque actuelle sera remplacée, après une sauvegarde de sécurité dans ton dossier.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” of %@: %lld documents, %lld notes, %lld cards. Your current library will be replaced, after a safety backup in your folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » du %@ : %lld documents, %lld notes, %lld cartes. Ta bibliothèque actuelle sera remplacée, après une sauvegarde de sécurité dans ton dossier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 的“%1$@”：%3$lld 个文档、%4$lld 条笔记、%5$lld 张卡片。你当前的书库将被替换，替换前会在你的文件夹中创建安全备份。"
          }
        }
      }
    },
    "« %@ » est déjà dans la bibliothèque : import annulé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already in the library: import cancelled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà dans la bibliothèque : import annulé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "《%@》已在资料库中：已取消导入。"
          }
        }
      }
    },
    "« %@ » importé avec ses notes, OCR, lectures IA, traductions et analyse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” imported with its notes, OCR, AI readings, translations and analysis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » importé avec ses notes, OCR, lectures IA, traductions et analyse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已导入，包含笔记、OCR、AI 识别结果、译文和分析。"
          }
        }
      }
    },
    "« Ajouter des pages… » (appui long sur le livre dans la bibliothèque). Les ajouts faits avant cette version ne sont pas listés.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Add pages…” (long-press the book in the library). Additions made before this version are not listed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ajouter des pages… » (appui long sur le livre dans la bibliothèque). Les ajouts faits avant cette version ne sont pas listés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“添加页面……”（在书库中长按书籍）。此版本之前的添加不会列出。"
          }
        }
      }
    },
    "« Importer » ajoute des PDF depuis Fichiers ou Google Drive. Les outils convertissent aussi des photos en PDF et fusionnent plusieurs PDF.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Import” adds PDFs from Files or Google Drive. The tools also convert photos to PDF and merge several PDFs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Importer » ajoute des PDF depuis Fichiers ou Google Drive. Les outils convertissent aussi des photos en PDF et fusionnent plusieurs PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“导入”可从“文件”或 Google Drive 添加 PDF。工具还能将照片转为 PDF 并合并多个 PDF。"
          }
        }
      }
    },
    "« Révisions » propose chaque jour les mots gardés, au bon moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Reviews” offers the saved words each day, at the right time."
          }
        },
