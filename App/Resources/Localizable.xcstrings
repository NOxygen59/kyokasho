    "Ajoute au moins deux PDF. Range-les en les faisant glisser : ils seront fusionnés de haut en bas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least two PDFs. Drag to reorder them: they will be merged from top to bottom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute au moins deux PDF. Range-les en les faisant glisser : ils seront fusionnés de haut en bas."
          }
        }
      }
    },
    "Ajoute ce modèle depuis l'écran « Analyser le document entier » du livre. La traduction française l'utilise toujours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this model from the book's “Analyze the whole document” screen. French translation always uses it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ce modèle depuis l'écran « Analyser le document entier » du livre. La traduction française l'utilise toujours."
          }
        }
      }
    },
    "Ajoute des cartes avec ＋ dans le popup du dictionnaire.": {
      "localizations": {
