          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张图片一页，保持其形状。很大的照片会被缩小（A4 上约 300 dpi，足够 OCR）。一切都在 iPad 上进行：不会联网发送任何内容。"
          }
