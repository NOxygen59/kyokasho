    "Ne garde que les mots les plus probables dont la somme atteint cette part. 1 : aucun filtre ; 0,9 : écarte les choix improbables.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps only the most likely words whose sum reaches this share. 1: no filter; 0.9: drops unlikely choices."
          }
        }
      }
    },
