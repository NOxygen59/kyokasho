        }
      }
    },
    "Vignettes, pages nettoyées, fichiers temporaires et cache web : l'app les refait au besoin. Tes PDF, notes, textes lus, analyses et modèles restent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumbnails, cleaned pages, temporary files and web cache: the app rebuilds them when needed. Your PDFs, notes, read texts, analyses and models stay."
          }
        }
      }
    },
    "Voir le détail": {
      "localizations": {
        "en": {
