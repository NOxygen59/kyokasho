    },
    "%lld mesures. Seules les périodes sur batterie comptent ; le débit s'affiche après 10 minutes d'une même activité. CPU : 100 %% = un cœur occupé en continu ; le GPU (IA locale) se voit dans la batterie et la chaleur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld readings. Only periods on battery count; the rate appears after 10 minutes of the same activity. CPU: 100 %% = one core busy continuously; the GPU (local AI) shows up in battery and heat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mesures. Seules les périodes sur batterie comptent ; le débit s'affiche après 10 minutes d'une même activité. CPU : 100 %% = un cœur occupé en continu ; le GPU (IA locale) se voit dans la batterie et la chaleur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 次记录。只统计使用电池的时段；同一活动持续 10 分钟后才显示耗电速度。CPU：100 %% 表示一个核心持续繁忙；GPU（本地 AI）的消耗体现在电量和发热上。"
          }
        }
      }
    },
